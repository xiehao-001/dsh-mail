{
  "name": "@eduwork/dsh-mail",
  "version": "0.2.5",
  "description": "Standards-based IMAP/SMTP assistant with explicit read/send separation and approval-gated delivery.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MulanPSL-2.0 AND MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/**/*",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "MARKET.md",
    "docs/**/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=24.18.0",
    "dsh": ">=0.2.1 <0.3.0"
  },
  "keywords": [
    "mail",
    "imap",
    "smtp",
    "approval"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.1.0 || 4.1.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-rc.2 <0.3.0-0 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.2 <0.3.0-0 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-rc.2 <0.3.0-0 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.2 <0.3.0-0 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-permission-presets": ">=0.2.1-rc.2 <0.3.0-0 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0-0 || >=0.2.2-rc.1 <0.2.3-0",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.2 <0.3.0-0 || >=0.2.2-rc.1 <0.2.3-0"
  }
}
